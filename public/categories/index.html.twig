{% extends "layouts/main.html.twig" %}
{% block title %}Categorías de Consumo{% endblock %}
{% block content %}
<div class="row">
  <div class="col-md-12">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h1><i class="bi bi-tags"></i> Categorías de Consumo</h1>
      <a href="{{ base_url }}/category/new" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nueva Categoría</a>
    </div>

    <div class="card shadow-sm">
      <div class="card-header bg-light">
        <strong>Listado de Categorías</strong>
      </div>
      <div class="card-body p-0">
        {% if categories|length > 0 %}
          <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th style="width: 60px;">#</th>
                  <th>Nombre</th>
                  <th>Descripción</th>
                  <th style="width: 160px;" class="text-end">Acciones</th>
                </tr>
              </thead>
              <tbody>
                {% for category in categories %}
                  <tr>
                    <td>{{ category.id }}</td>
                    <td><strong class="text-primary">{{ category.name }}</strong></td>
                    <td class="text-muted">{{ category.description|default('Sin descripción') }}</td>
                    <td class="text-end">
                      <a href="{{ base_url }}/category/{{ category.id }}/edit" class="btn btn-warning btn-sm"><i class="bi bi-pencil"></i></a>
                      <form action="{{ base_url }}/category/{{ category.id }}/delete" method="POST" class="d-inline" onsubmit="return confirm('¿Eliminar esta categoría?');">
                        {{ csrf_field() }}
                        <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash"></i></button>
                      </form>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% else %}
          <div class="p-4 text-center text-muted">
            <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
            No hay categorías de consumo registradas.
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% endblock %}
