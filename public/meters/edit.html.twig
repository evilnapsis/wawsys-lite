{% extends "layouts/main.html.twig" %}
{% block title %}Editar Medidor{% endblock %}
{% block content %}
<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h1><i class="bi bi-pencil-square"></i> Editar Medidor</h1>
      <a href="{{ base_url }}/meters" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
    </div>

    <div class="card shadow-sm">
      <div class="card-header bg-light">
        <strong>Editar Medidor: {{ meter.identifier }}</strong>
      </div>
      <div class="card-body">
        {% if errors is defined and errors|length > 0 %}
          <div class="alert alert-danger">
            <ul class="mb-0">
              {% for error in errors %}
                <li>{{ error }}</li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}

        <form method="post" action="{{ base_url }}/meter/{{ meter.id }}/update">
          {{ csrf_field() }}
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label fw-bold">Identificador del Medidor *</label>
              <input type="text" name="identifier" required class="form-control" value="{{ meter.identifier }}">
            </div>

            <div class="col-md-6 mb-3">
              <label class="form-label fw-bold">Marca *</label>
              <input type="text" name="brand" required class="form-control" value="{{ meter.brand }}">
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label fw-bold">Número de Serie *</label>
              <input type="text" name="serie" required class="form-control" value="{{ meter.serie }}">
            </div>

            <div class="col-md-6 mb-3">
              <label class="form-label fw-bold">Estado *</label>
              <select name="status" class="form-select">
                <option value="1" {{ (meter.status == 1) ? 'selected' : '' }}>1. Activo</option>
                <option value="2" {{ (meter.status == 2) ? 'selected' : '' }}>2. Mantenimiento</option>
                <option value="3" {{ (meter.status == 3) ? 'selected' : '' }}>3. Baja</option>
              </select>
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Fecha de Expedición</label>
              <input type="date" name="issued_at" class="form-control" value="{{ meter.issued_at }}">
            </div>

            <div class="col-md-6 mb-3">
              <label class="form-label">Fecha de Expiración</label>
              <input type="date" name="expired_at" class="form-control" value="{{ meter.expired_at }}">
            </div>
          </div>

          <div class="text-end">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> Actualizar Medidor</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{% endblock %}
