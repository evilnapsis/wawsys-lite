{% extends "layouts/main.html.twig" %}
{% block title %}Nuevo Medidor{% endblock %}
{% block content %}
<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h1><i class="bi bi-speedometer"></i> Nuevo Medidor</h1>
      <a href="{{ base_url }}/meters" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
    </div>

    <div class="card shadow-sm">
      <div class="card-header bg-light">
        <strong>Ficha Técnica del Medidor</strong>
      </div>
      <div class="card-body">
        {% if errors is defined and errors|length > 0 %}
          <div class="alert alert-danger">
            <ul class="mb-0">
              {% for error in errors %}
                <li>{{ error }}</li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}

        <form method="post" action="{{ base_url }}/meter/create">
          {{ csrf_field() }}
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label fw-bold">Identificador del Medidor *</label>
              <input type="text" name="identifier" required class="form-control" value="{{ old.identifier|default('') }}" placeholder="Ej: MED-001, M-1049...">
              <div class="form-text">Código o número identificador único del medidor.</div>
            </div>

            <div class="col-md-6 mb-3">
              <label class="form-label fw-bold">Marca *</label>
              <input type="text" name="brand" required class="form-control" value="{{ old.brand|default('') }}" placeholder="Ej: Zenner, Elster, Badger...">
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label fw-bold">Número de Serie *</label>
              <input type="text" name="serie" required class="form-control" value="{{ old.serie|default('') }}" placeholder="Ej: SN-98765432">
            </div>

            <div class="col-md-6 mb-3">
              <label class="form-label fw-bold">Estado *</label>
              <select name="status" class="form-select">
                <option value="1" {{ (old.status|default(1) == 1) ? 'selected' : '' }}>1. Activo</option>
                <option value="2" {{ (old.status|default(1) == 2) ? 'selected' : '' }}>2. Mantenimiento</option>
                <option value="3" {{ (old.status|default(1) == 3) ? 'selected' : '' }}>3. Baja</option>
              </select>
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Fecha de Expedición (Opcional)</label>
              <input type="date" name="issued_at" class="form-control" value="{{ old.issued_at|default('') }}">
            </div>

            <div class="col-md-6 mb-3">
              <label class="form-label">Fecha de Expiración (Opcional)</label>
              <input type="date" name="expired_at" class="form-control" value="{{ old.expired_at|default('') }}">
            </div>
          </div>

          <div class="text-end">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> Guardar Medidor</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{% endblock %}
