{% extends "layouts/main.html.twig" %}
{% block title %}Ubicaciones y Sectores{% endblock %}
{% block content %}
<div class="row">
  <div class="col-md-12">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h1><i class="bi bi-geo-alt"></i> Ubicaciones y Sectores</h1>
      <a href="{{ base_url }}/location/new" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nueva Ubicación</a>
    </div>

    <div class="card shadow-sm">
      <div class="card-header bg-light">
        <strong>Listado de Sectores / Zonas de Lectura</strong>
      </div>
      <div class="card-body p-0">
        {% if locations|length > 0 %}
          <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th style="width: 60px;">#</th>
                  <th>Sector / Nombre</th>
                  <th>Descripción</th>
                  <th>Fecha Registro</th>
                  <th style="width: 160px;" class="text-end">Acciones</th>
                </tr>
              </thead>
              <tbody>
                {% for loc in locations %}
                  <tr>
                    <td>{{ loc.id }}</td>
                    <td><strong class="text-primary"><i class="bi bi-pin-map me-1"></i>{{ loc.name }}</strong></td>
                    <td class="text-muted">{{ loc.description|default('Sin descripción') }}</td>
                    <td>{{ loc.created_at|slice(0, 10) }}</td>
                    <td class="text-end">
                      <a href="{{ base_url }}/location/{{ loc.id }}/edit" class="btn btn-warning btn-sm" title="Editar"><i class="bi bi-pencil"></i></a>
                      <form action="{{ base_url }}/location/{{ loc.id }}/delete" method="POST" class="d-inline" onsubmit="return confirm('¿Eliminar esta ubicación?');">
                        {{ csrf_field() }}
                        <button type="submit" class="btn btn-danger btn-sm" title="Eliminar"><i class="bi bi-trash"></i></button>
                      </form>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% else %}
          <div class="p-4 text-center text-muted">
            <i class="bi bi-geo fs-3 d-block mb-2"></i>
            No hay ubicaciones registradas todavía.
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% endblock %}
